  m_text: " Originally built in the 16th century, De Gooyer is Amsterdam\u2019s tallest
    wooden \r\nwindmill. Today it stands beside a brewery, drawing visitors from
    all over the \r\nworld."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
